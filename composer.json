{
    "name": "goaop/goaop-symfony-bundle",
    "description": "Symfony bundle for the Go! AOP framework: transparent aspect weaving for Symfony applications",
    "type": "symfony-bundle",
    "keywords": [
        "bundle",
        "symfony",
        "aop",
        "php",
        "aspect",
        "aspect-oriented-programming"
    ],
    "homepage": "https://go.aopphp.com/",
    "license": "MIT",
    "authors": [
        {
            "name": "Lisachenko Alexander",
            "email": "lisachenko.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goaop/goaop-symfony-bundle/issues",
        "source": "https://github.com/goaop/goaop-symfony-bundle"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/lisachenko"
        }
    ],
    "require": {
        "php": "^8.4",
        "goaop/framework": "^4.0@dev",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/error-handler": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/dom-crawler": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Lets the bundle wire woven Doctrine entities into the ORM mapping drivers"
    },
    "autoload": {
        "psr-4": {
            "Go\\Symfony\\GoAopBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Go\\Symfony\\GoAopBundle\\Tests\\Fixtures\\App\\": "tests/Fixtures/App/src/",
            "Go\\Symfony\\GoAopBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "4.0-dev"
        }
    }
}
